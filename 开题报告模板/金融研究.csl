<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0"
       demote-non-dropping-particle="never" default-locale="en-US"
       name-delimiter=", " initialize-with=" " names-delimiter=". "
       name-as-sort-order="first" sort-separator=" ">
  <info>
    <title>浙江工商大学本科毕业论文（金融研究体例）</title>
    <id>https://example.local/zjgsu-jinrongyanjiu</id>
    <link href="http://www.jryj.org.cn/CN/column/column3.shtml" rel="documentation"/>
    <category citation-format="author-date"/>
    <category field="social_science"/>
    <updated>2026-11-06T00:00:00+08:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</rights>
  </info>

  <!--
    说明：pandoc 的 citeproc 不能按单条文献的语言切换地区词，
    因此这里把“等”设为全局 et-al 词（中文用），英文条目通过
    et-al-min=20 不触发 et-al，改为列全作者。
    中文作者之间统一用顿号“、”（校样例中两位作者用“和”，
    这是本模板与校样例唯一的可见差异，详见《操作说明》）。
  -->
  <locale xml:lang="en">
    <terms>
      <term name="et-al">等</term>
      <term name="page-range-delimiter">-</term>
    </terms>
  </locale>
  <locale xml:lang="zh">
    <terms>
      <term name="anonymous">佚名</term>
      <term name="et-al">等</term>
      <term name="and">and</term>
      <term name="page-range-delimiter">-</term>
      <term name="open-quote">“</term>
      <term name="close-quote">”</term>
    </terms>
  </locale>

  <!-- 中文文献排英文文献之前 -->
  <macro name="langkey">
    <choose>
      <if variable="language">
        <text value="1"/>
      </if>
      <else>
        <text value="2"/>
      </else>
    </choose>
  </macro>

  <macro name="issued-year">
    <choose>
      <if variable="issued">
        <date variable="issued" date-parts="year" form="numeric"/>
      </if>
      <else>
        <text term="no date" prefix="[" suffix="]"/>
      </else>
    </choose>
  </macro>

  <!-- ============ 正文引用：（作者，年份） ============ -->
  <citation collapse="year" cite-group-delimiter="；"
            disambiguate-add-givenname="true" disambiguate-add-year-suffix="true">
    <sort>
      <key macro="author-intext"/>
      <key macro="issued-year"/>
    </sort>
    <layout prefix="（" suffix="）" delimiter="；">
      <choose>
        <if variable="language">
          <group delimiter="，">
            <names variable="author">
              <name form="short" delimiter="、" delimiter-precedes-last="never"
                    et-al-min="3" et-al-use-first="1"/>
              <substitute>
                <text variable="title" form="short"/>
              </substitute>
            </names>
            <text macro="issued-year"/>
            <group delimiter=" ">
              <label variable="locator" form="short"/>
              <text variable="locator"/>
            </group>
          </group>
        </if>
        <else>
          <group delimiter="，">
            <names variable="author">
              <name form="short" and="text" delimiter=", "
                    et-al-min="20" et-al-use-first="19"/>
              <substitute>
                <text variable="title" form="short"/>
              </substitute>
            </names>
            <text macro="issued-year"/>
            <group delimiter=" ">
              <label variable="locator" form="short"/>
              <text variable="locator"/>
            </group>
          </group>
        </else>
      </choose>
    </layout>
  </citation>

  <macro name="author-intext">
    <names variable="author">
      <name form="short" delimiter="、" delimiter-precedes-last="never"
            et-al-min="3" et-al-use-first="1"/>
      <substitute>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>

  <!-- ============ 文末参考文献 ============ -->
  <macro name="author-zh">
    <names variable="author">
      <name delimiter="、" delimiter-precedes-last="never" initialize="false"
            et-al-min="20" et-al-use-first="19"/>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-en">
    <names variable="author">
      <name name-as-sort-order="first" initialize-with=". " and="text"
            delimiter=", " delimiter-precedes-last="always" sort-separator=", ">
        <name-part name="family" text-case="capitalize-first"/>
      </name>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="editor-zh">
    <group>
      <names variable="editor">
        <name delimiter="、" delimiter-precedes-last="never" initialize="false"/>
      </names>
      <text value="主编"/>
    </group>
  </macro>

  <macro name="translator-zh">
    <group>
      <names variable="translator">
        <name delimiter="、" delimiter-precedes-last="never" initialize="false"/>
      </names>
      <text value="译"/>
    </group>
  </macro>

  <macro name="entry-zh">
    <group>
      <text macro="author-zh" suffix="，"/>
      <text macro="issued-year"/>
      <text variable="title" prefix="，《" suffix="》"/>
      <choose>
        <if type="article-journal article-magazine" match="any">
          <group prefix="，" suffix="。" delimiter="，">
            <group>
              <text variable="container-title" prefix="《" suffix="》"/>
              <text variable="issue" prefix="第" suffix="期"/>
            </group>
            <text variable="page" prefix="第" suffix="页"/>
          </group>
        </if>
        <else-if type="article-newspaper" match="any">
          <group prefix="，" suffix="。" delimiter="，">
            <group>
              <text variable="container-title" prefix="《" suffix="》"/>
              <date variable="issued">
                <date-part name="year" suffix="年"/>
                <date-part name="month" suffix="月"/>
                <date-part name="day" suffix="日"/>
              </date>
            </group>
            <text variable="edition" prefix="第" suffix="版"/>
          </group>
        </else-if>
        <else-if type="thesis" match="any">
          <group prefix="，" suffix="。">
            <text variable="publisher"/>
            <text variable="genre"/>
          </group>
        </else-if>
        <else-if type="chapter paper-conference" match="any">
          <group prefix="，" suffix="。" delimiter="，">
            <text value="载"/>
            <group>
              <text macro="editor-zh"/>
              <text value="主编"/>
            </group>
            <text variable="container-title" prefix="《" suffix="》"/>
            <text variable="publisher"/>
            <text variable="page" prefix="第" suffix="页"/>
          </group>
        </else-if>
        <else-if type="report" match="any">
          <group prefix="，" suffix="。" delimiter="，">
            <text variable="publisher"/>
            <text variable="genre"/>
            <text variable="number"/>
          </group>
        </else-if>
        <else>
          <group prefix="，" suffix="。" delimiter="，">
            <text macro="translator-zh"/>
            <text macro="editor-zh"/>
            <text variable="publisher"/>
          </group>
        </else>
      </choose>
    </group>
  </macro>

  <macro name="entry-en">
    <group>
      <text macro="author-en" suffix=", "/>
      <text macro="issued-year" suffix=", "/>
      <choose>
        <if type="article-journal article-magazine article-newspaper chapter paper-conference" match="any">
          <text variable="title" prefix="“" suffix="”"/>
        </if>
        <else>
          <text variable="title" font-style="italic"/>
        </else>
      </choose>
      <choose>
        <if type="article-journal article-magazine" match="any">
          <group prefix=", " suffix="." delimiter=", ">
            <text variable="container-title" font-style="italic"/>
            <group>
              <text variable="volume"/>
              <text variable="issue" prefix="(" suffix=")"/>
              <text variable="page" prefix=": "/>
            </group>
          </group>
        </if>
        <else-if type="article-newspaper" match="any">
          <group prefix=", " suffix="." delimiter=", ">
            <text variable="container-title" font-style="italic"/>
            <date variable="issued">
              <date-part name="month" suffix=" "/>
              <date-part name="day" suffix=", "/>
              <date-part name="year"/>
            </date>
          </group>
        </else-if>
        <else-if type="thesis" match="any">
          <group prefix=", " suffix=".">
            <text variable="publisher"/>
            <text variable="genre" prefix=" "/>
          </group>
        </else-if>
        <else-if type="chapter paper-conference" match="any">
          <group prefix=", " suffix="." delimiter=", ">
            <text value="in"/>
            <text variable="editor"/>
            <text variable="container-title" font-style="italic"/>
            <group delimiter=": ">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
            </group>
            <text variable="page"/>
          </group>
        </else-if>
        <else-if type="report" match="any">
          <group prefix=", " suffix="." delimiter=", ">
            <text variable="publisher"/>
            <text variable="genre"/>
            <text variable="number" prefix="No. "/>
          </group>
        </else-if>
        <else>
          <group prefix=", " suffix="." delimiter=", ">
            <text variable="edition" suffix=" ed."/>
            <group delimiter=": ">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
            </group>
          </group>
        </else>
      </choose>
    </group>
  </macro>

  <bibliography entry-spacing="0" line-spacing="1" hanging-indent="true">
    <sort>
      <key macro="langkey"/>
      <key macro="author-intext"/>
      <key macro="issued-year"/>
    </sort>
    <layout>
      <text variable="citation-number" prefix="[" suffix="] "/>
      <choose>
        <if variable="language">
          <text macro="entry-zh"/>
        </if>
        <else>
          <text macro="entry-en"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
